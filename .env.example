# Copier ce fichier en .env (et en apps/api/.env, apps/web/.env.local si besoin)
# et renseigner les vraies valeurs. Ne jamais committer de .env réel.

# --- Base de données ---
DATABASE_URL="postgresql://mivitrina:mivitrina@localhost:5432/mivitrina?schema=public"

# --- Redis (jobs asynchrones, cache) ---
REDIS_URL="redis://localhost:6379"

# --- API ---
NODE_ENV="development"
PORT=4000
WEB_APP_URL="http://localhost:3000"

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# --- Auth ---
# Secrets JWT : générer des valeurs aléatoires fortes en production
# (ex: openssl rand -hex 32). Ne jamais réutiliser le même secret pour
# les 3 usages ci-dessous.
JWT_ACCESS_SECRET="changeme-access-secret-min-16-chars"
JWT_REFRESH_SECRET="changeme-refresh-secret-min-16-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# Signe les liens de vérification email / réinitialisation de mot de passe.
EMAIL_TOKEN_SECRET="changeme-email-token-secret-min-16"
# Domaine partagé pour les cookies en prod (ex: ".mivitrina.es").
# Laisser vide en local (cookie scopé à localhost).
COOKIE_DOMAIN=""

# Bootstrap du compte admin (voir `pnpm db:seed`) — n'est jamais
# créable via l'inscription publique.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Stripe Connect ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Stockage fichiers (S3 / MinIO en local) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west-3"
S3_BUCKET="mivitrina-dev"
S3_ACCESS_KEY_ID="mivitrina"
S3_SECRET_ACCESS_KEY="mivitrina-local"

# --- Emails transactionnels ---
# Si RESEND_API_KEY est vide, les emails sont simplement loggés en
# console (utile en dev sans compte Resend).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MiVitrina <no-reply@mivitrina.es>"

# --- Géolocalisation ---
GOOGLE_MAPS_API_KEY=""

# --- Vérification identité entreprise ---
# France : API INSEE (SIRENE) - https://api.insee.fr/
INSEE_API_KEY=""
